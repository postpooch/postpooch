ZERNIO_API_KEY=
DATABASE_URL=
# Server-only: Jev routing. Live evaluation remains pending until access is available.
TYPESAFE_API_KEY=
# Server-only LangChain provider:model identifier (for example openai:gpt-5.6-terra).
SOCIAL_MEDIA_MUTATION_MODEL=openai:gpt-5.6-terra
# Server-only and only required when the configured mutation model uses OpenAI.
OPENAI_API_KEY=
# Server-only and only required when a configured model uses the
# `openrouter:` prefix. All model roles use the same universal factory.
OPENROUTER_API_KEY=
# Trigger.dev Context User model configuration. Each role independently accepts
# any provider:model supported by the universal LangChain factory.
SOCIAL_MEDIA_CREATIVE_MODEL=openrouter:z-ai/glm-5.3-flash
SOCIAL_MEDIA_DESIGN_MODEL=openrouter:anthropic/claude-haiku-5.5
SOCIAL_MEDIA_VISION_MODEL=openrouter:anthropic/claude-haiku-5.5
SOCIAL_MEDIA_MODEL_TIMEOUT_MS=90000
# Current backend credential used inside the generic image-discovery service. Server-only.
PIXABAY_API_KEY=
# Other LangChain providers use their own server-only credential, such as
# ANTHROPIC_API_KEY or GOOGLE_API_KEY. Never use NEXT_PUBLIC_ for model secrets.
# Test-only: an isolated local PostgreSQL/Supabase database whose name contains "test".
# Never point repository integration tests at staging or production.
SOCIAL_MEDIA_CONTEXT_TEST_DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Newsletter dispatch (server-only). The queue URL is a CDK stack output.
# Use a Vercel AWS integration/assumable role with the generated
# postpooch-newsletter-vercel-dispatch policy; do not expose credentials with NEXT_PUBLIC_.
NEWSLETTER_AWS_REGION=us-east-1
NEWSLETTER_CAMPAIGN_QUEUE_URL=
# Separate queue for asynchronous per-customer SES identity and tenant setup.
NEWSLETTER_SENDER_SETUP_QUEUE_URL=
# Shared SES settings record associated with every customer tenant.
NEWSLETTER_SES_CONFIGURATION_SET=my-first-configuration-set

# Parent domain for public agent sites (sally.postpooch.com → /websites/sally).
# Unset = no production tenant-host rewriting (*.localhost still works locally).
TENANT_ROOT_DOMAIN=postpooch.com

# Trigger.dev — from Project Settings → API Keys
# Use the Secret key for the environment you are targeting (tr_dev_… / tr_prod_…).
TRIGGER_SECRET_KEY=

# Optional. Qualifies schedule deduplication keys across environments
# (dev | staging | prod). Defaults to "prod" when NODE_ENV=production, else "dev".
TRIGGER_SCHEDULE_ENV=

# Cloudflare R2
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
ZERNIO_WEBHOOK_SECRET=
# Daily GBP sync defaults to a conservative 40 requests/minute across four workers.
GOOGLE_BUSINESS_SYNC_REQUESTS_PER_MINUTE=40
